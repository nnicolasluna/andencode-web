---
const bgUrl = "https://www.figma.com/api/mcp/asset/bad64031-11e8-4209-aaf5-674d931f2171";
const logoBrillanteUrl = "https://www.figma.com/api/mcp/asset/8e7b7126-9a70-4d5e-809a-14c15685eaa5";
---

<section
  id="inicio"
  class="relative w-full min-h-screen flex flex-col items-center justify-center overflow-hidden bg-[#000015]"
>
  <!-- Background photo -->
  <div class="absolute inset-0">
    <img
      src={bgUrl}
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover opacity-40 pointer-events-none"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#000015]/60 via-transparent to-[#000015]/80"></div>
  </div>

  <!-- Decorative conic gradients (left) -->
  <div
    class="absolute left-0 top-0 w-[600px] h-[600px] mix-blend-color-dodge opacity-20 pointer-events-none"
    style="background: conic-gradient(from 90deg, #d9d9d9 0%, #000000 0%, #0a0a0a 6.2%, #3f3f3f 37%, #9e9e9e 74%, #d9d9d9 100%); transform: rotate(-135deg); transform-origin: center;"
  ></div>

  <!-- Decorative conic gradients (right) -->
  <div
    class="absolute right-0 top-0 w-[600px] h-[600px] mix-blend-color-dodge opacity-20 pointer-events-none"
    style="background: conic-gradient(from 90deg, #d9d9d9 0%, #000000 0%, #0a0a0a 6.2%, #3f3f3f 37%, #9e9e9e 74%, #d9d9d9 100%); transform: rotate(135deg); transform-origin: center;"
  ></div>

  <!-- Glowing logo -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 opacity-20 pointer-events-none">
    <img src={logoBrillanteUrl} alt="" aria-hidden="true" class="w-full h-full object-cover" />
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-5xl mx-auto pt-20">
    <h1 class="font-audiowide text-5xl md:text-6xl lg:text-7xl text-white leading-tight mb-4">
      Desarrollo de Software
    </h1>
    <p class="font-inconsolata font-black text-5xl md:text-6xl lg:text-7xl leading-tight">
      <span class="text-[#fab306]">Potenciado con</span>
      <span class="text-white"> IA</span>
    </p>

    <p class="mt-8 font-inconsolata text-white/80 text-base md:text-lg max-w-xl mx-auto leading-relaxed">
      Tecnología de vanguardia adaptada a las necesidades específicas de tu negocio.
      Creamos soluciones inteligentes que transforman tu empresa.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="#contacto"
        class="inline-flex items-center justify-center px-8 py-3.5 rounded-[5px] font-inconsolata font-semibold text-sm text-[#fafafa] bg-[#fab306] hover:bg-[#e5a005] transition-colors"
        style="box-shadow: 0 4px 24.5px rgba(0,0,0,0.15);"
      >
        Agenda una reunión
      </a>
      <a
        href="#servicios"
        class="inline-flex items-center justify-center px-8 py-3.5 rounded-[5px] font-inconsolata font-medium text-sm text-white border border-white/30 hover:border-white/60 transition-colors"
      >
        Ver servicios
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce">
    <svg class="w-6 h-6 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>
